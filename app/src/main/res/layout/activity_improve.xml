<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SKILLQUIZ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="#2956A3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi progreso"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Revisa tus resultados y sigue mejorando."
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/fondo_banner"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ÚLTIMO CUESTIONARIO"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E3ECFA" />

            <TextView
                android:id="@+id/txtUltimoPuntaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin resultados"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/txtPorcentajeMejora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completa tu primer cuestionario"
                android:textSize="15sp"
                android:textColor="#E3ECFA"
                android:layout_marginTop="6dp" />

            <ProgressBar
                android:id="@+id/progresoMejora"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#829ECD"
                android:layout_marginTop="22dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/fondo_tarjeta">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textSize="27sp"
                    android:textColor="#248578" />

                <TextView
                    android:id="@+id/txtCorrectasMejora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#183153"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correctas"
                    android:textSize="14sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <Space
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/fondo_tarjeta">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textSize="27sp"
                    android:textColor="#C45B50" />

                <TextView
                    android:id="@+id/txtIncorrectasMejora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#183153"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Incorrectas"
                    android:textSize="14sp"
                    android:textColor="#64748B" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recomendaciones"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/txtConsejos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa un cuestionario para recibir consejos."
            android:textSize="15sp"
            android:textColor="#334155"
            android:lineSpacingExtra="8dp"
            android:padding="20dp"
            android:background="@drawable/fondo_tarjeta"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repasa tus respuestas"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulta las preguntas que fallaste y aprende las respuestas correctas."
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnVerErrores"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver mis errores y repasar"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:backgroundTint="#DCE8F8"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnPracticarOtraVez"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Practicar otra vez"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2956A3"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btnVolverMejora"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Volver al menú"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#183153"
            android:backgroundTint="#E4EBF5"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
