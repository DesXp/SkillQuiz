<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SK"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#2956A3"
            android:gravity="center"
            android:padding="25dp"
            android:background="@drawable/fondo_tarjeta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SkillQuiz"
            android:textSize="37sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:gravity="center"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pon a prueba tus conocimientos de informática."
            android:textSize="16sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/fondo_tarjeta"
            android:layout_marginTop="35dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aprende"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#183153" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preguntas sobre tecnología e informática."
                android:textSize="14sp"
                android:textColor="#64748B"
                android:layout_marginTop="5dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E4E9F1"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Practica"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#183153" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Responde cuestionarios con preguntas aleatorias."
                android:textSize="14sp"
                android:textColor="#64748B"
                android:layout_marginTop="5dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E4E9F1"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mejora"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#183153" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consulta tus puntajes y sigue mejorando."
                android:textSize="14sp"
                android:textColor="#64748B"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnEmpezar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Empezar"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2956A3"
            android:layout_marginTop="35dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SkillQuiz | Proyecto académico"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginTop="25dp" />

    </LinearLayout>
</ScrollView>
