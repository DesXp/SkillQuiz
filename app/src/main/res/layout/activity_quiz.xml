<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CUESTIONARIO"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="#2956A3" />

                <TextView
                    android:id="@+id/txtNumeroPregunta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pregunta 1 de 10"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#183153"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/fondo_tiempo_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ "
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:30"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#2956A3" />

            </LinearLayout>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progresoQuiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="10"
            android:progress="1"
            android:progressTint="#2956A3"
            android:progressBackgroundTint="#DEE6F2"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/barraTiempo"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="30000"
            android:progress="30000"
            android:progressTint="#D49A40"
            android:progressBackgroundTint="#E3E8EF"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/fondo_tarjeta"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECCIONA UNA RESPUESTA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/txtPregunta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pregunta"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#183153"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/grupoRespuestas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/opcion1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="10dp"
                    android:text="Alternativa A"
                    android:textSize="14sp"
                    android:textColor="#26364A"
                    android:buttonTint="#2956A3"
                    android:background="@drawable/selector_opcion" />

                <RadioButton
                    android:id="@+id/opcion2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="10dp"
                    android:text="Alternativa B"
                    android:textSize="14sp"
                    android:textColor="#26364A"
                    android:buttonTint="#2956A3"
                    android:background="@drawable/selector_opcion"
                    android:layout_marginTop="6dp" />

                <RadioButton
                    android:id="@+id/opcion3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="10dp"
                    android:text="Alternativa C"
                    android:textSize="14sp"
                    android:textColor="#26364A"
                    android:buttonTint="#2956A3"
                    android:background="@drawable/selector_opcion"
                    android:layout_marginTop="6dp" />

                <RadioButton
                    android:id="@+id/opcion4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="10dp"
                    android:text="Alternativa D"
                    android:textSize="14sp"
                    android:textColor="#26364A"
                    android:buttonTint="#2956A3"
                    android:background="@drawable/selector_opcion"
                    android:layout_marginTop="6dp" />

            </RadioGroup>

        </LinearLayout>

        <Button
            android:id="@+id/btnSiguiente"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Siguiente pregunta"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2956A3"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tienes 30 segundos para responder cada pregunta."
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp" />

    </LinearLayout>
</ScrollView>
