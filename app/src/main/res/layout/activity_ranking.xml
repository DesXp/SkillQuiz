<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SKILLQUIZ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="#2956A3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi ranking"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginTop="7dp" />

        <TextView
            android:id="@+id/txtNombreRanking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis estadísticas"
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/fondo_banner"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MIS PUNTOS ACUMULADOS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:textColor="#DDE9FC" />

            <TextView
                android:id="@+id/txtPuntosAcumulados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 puntos"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="15dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cada respuesta correcta suma 1 punto."
                android:textSize="14sp"
                android:textColor="#E3ECFA"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/fondo_tarjeta">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PARTIDAS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/txtPartidasJugadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="31sp"
                    android:textStyle="bold"
                    android:textColor="#183153"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jugadas"
                    android:textSize="14sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <Space
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/fondo_tarjeta">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MEJOR PARTIDA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/txtMejorPartida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0/10"
                    android:textSize="31sp"
                    android:textStyle="bold"
                    android:textColor="#183153"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mi récord"
                    android:textSize="14sp"
                    android:textColor="#64748B" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/fondo_tarjeta"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rendimiento general"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#183153" />

            <TextView
                android:id="@+id/txtPromedioRanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0% de aciertos"
                android:textSize="15sp"
                android:textColor="#64748B"
                android:layout_marginTop="12dp" />

            <ProgressBar
                android:id="@+id/barraPromedioRanking"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#2956A3"
                android:progressBackgroundTint="#DEE6F2"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:background="#E2E8F0"
            android:padding="3dp"
            android:layout_marginTop="28dp">

            <TextView
                android:id="@+id/btnTabMisPartidas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Mis partidas"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/fondo_banner"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnTabTopEstudiantes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Top estudiantes"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtSubtituloSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial personal guardado en este dispositivo."
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginTop="10dp" />

        <ProgressBar
            android:id="@+id/progresoCargaRanking"
            style="?android:attr/progressBarStyle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtVacioRanking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todavía no tienes partidas guardadas."
            android:textSize="15sp"
            android:textColor="#64748B"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorialRanking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnLimpiarHistorial"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Borrar historial local"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#DC2626"
            android:backgroundTint="#FEE2E2"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnJugarRanking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Jugar otra partida"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2956A3"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnVolverRanking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Volver al menú"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#183153"
            android:backgroundTint="#E4EBF5"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
