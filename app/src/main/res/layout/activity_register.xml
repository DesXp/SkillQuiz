<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SKILLQUIZ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="#2956A3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear cuenta"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa tus datos para comenzar."
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/fondo_tarjeta"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre completo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#183153" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Ingresa tu nombre"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#183153"
                android:textColorHint="#94A3B8"
                android:padding="14dp"
                android:background="@drawable/fondo_campo"
                android:layout_marginTop="9dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#183153"
                android:layout_marginTop="19dp" />

            <EditText
                android:id="@+id/etCorreoRegistro"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="ejemplo@correo.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#183153"
                android:textColorHint="#94A3B8"
                android:padding="14dp"
                android:background="@drawable/fondo_campo"
                android:layout_marginTop="9dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contraseña"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#183153"
                android:layout_marginTop="19dp" />

            <EditText
                android:id="@+id/etPasswordRegistro"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Mínimo 6 caracteres"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#183153"
                android:textColorHint="#94A3B8"
                android:padding="14dp"
                android:background="@drawable/fondo_campo"
                android:layout_marginTop="9dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmar contraseña"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#183153"
                android:layout_marginTop="19dp" />

            <EditText
                android:id="@+id/etConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Repite tu contraseña"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#183153"
                android:textColorHint="#94A3B8"
                android:padding="14dp"
                android:background="@drawable/fondo_campo"
                android:layout_marginTop="9dp" />

            <Button
                android:id="@+id/btnGuardarRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Registrarme"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2956A3"
                android:layout_marginTop="28dp" />

            <Button
                android:id="@+id/btnVolverLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Volver al login"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="#183153"
                android:backgroundTint="#E5ECF8"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SkillQuiz | Proyecto académico"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
